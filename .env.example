CPE_BASE_URL=http://192.168.21.1
CPE_USERNAME=root
CPE_PASSWORD=replace-with-device-password

# 浏览器访问页面时使用的密码（不需要用户名）
APP_PASSWORD=replace-with-page-password

# 登录默认保持 365 天；每次访问受保护接口会续期
AUTH_MAX_AGE_DAYS=365

# 使用 HTTPS 部署时改为 true
COOKIE_SECURE=false

# 可选；未设置时会从 APP_PASSWORD 派生 Cookie 签名密钥
SESSION_SECRET=

HOST=127.0.0.1
PORT=3100
